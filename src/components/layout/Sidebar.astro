---
const pathname = Astro.url.pathname;

const isProductosActive     = pathname.startsWith('/productos');
const isNuevoProductoActive = pathname === '/productos/nuevo';
const isDashboardActive     = pathname === '/';
---

<!-- ── Mobile: Barra superior fija ── -->
<div class="mobile-topbar">
  <div class="mobile-topbar-left">
    <button id="mobile-menu-toggle" type="button" aria-label="Abrir menú" class="mobile-hamburger-btn">
      ☰
    </button>
    <div class="mobile-topbar-logo">POS</div>
    <span class="mobile-topbar-title">Terminal POS</span>
  </div>
</div>

<!-- ── Overlay mobile ── -->
<div id="sidebar-overlay" class="sidebar-overlay"></div>

<!-- ── Sidebar principal ── -->
<aside id="app-sidebar" class="sidebar">

  <!-- Header con logo y nombre -->
  <div class="sidebar-header">
    <div class="sidebar-header-logo">POS</div>
    <span class="sidebar-header-title">Terminal POS</span>
  </div>

  <!-- Navegación -->
  <nav class="sidebar-nav">
    <span class="sidebar-section-label">General</span>

    <a href="/" class={`sidebar-nav-item ${isDashboardActive ? 'sidebar-nav-item--active' : ''}`}>
      <span class="sidebar-nav-item-icon">📊</span>
      <span class="sidebar-nav-item-label">Dashboard</span>
    </a>

    <span class="sidebar-section-label">Inventario</span>

    <a href="/productos/nuevo" class={`sidebar-nav-item ${isProductosActive ? 'sidebar-nav-item--active' : ''}`}>
      <span class="sidebar-nav-item-icon">📦</span>
      <span class="sidebar-nav-item-label">Productos</span>
    </a>

    <div class="sidebar-subnav">
      <a href="/productos/nuevo" class={`sidebar-subnav-item ${isNuevoProductoActive ? 'sidebar-subnav-item--active' : ''}`}>
        ➕ Nuevo producto
      </a>
    </div>
  </nav>

  <!-- Footer: selector de tema + usuario + logout -->
  <div class="sidebar-footer">

    <!-- Selector de tema -->
    <div class="sidebar-theme-picker">
      <span class="sidebar-theme-picker-label">Tema</span>
      <div class="sidebar-theme-dots">
        <button
          type="button"
          class="sidebar-theme-dot"
          data-dot="light"
          data-theme-value="light"
          aria-label="Tema claro"
          title="Claro"
        ></button>
        <button
          type="button"
          class="sidebar-theme-dot"
          data-dot="night"
          data-theme-value="night"
          aria-label="Tema oscuro"
          title="Noche"
        ></button>
        <button
          type="button"
          class="sidebar-theme-dot"
          data-dot="warm"
          data-theme-value="warm"
          aria-label="Tema cálido"
          title="Cálido"
        ></button>
        <button
          type="button"
          class="sidebar-theme-dot"
          data-dot="forest"
          data-theme-value="forest"
          aria-label="Tema bosque"
          title="Bosque"
        ></button>
      </div>
    </div>

    <!-- Usuario + logout -->
    <div class="sidebar-user-row">
      <div class="sidebar-user-avatar" id="user-avatar-initials">A</div>
      <div class="sidebar-user-info">
        <span class="sidebar-user-name" id="user-display-name">Admin POS</span>
        <span class="sidebar-user-role" id="user-display-role">Administrador</span>
      </div>
      <button
        id="btn-logout"
        type="button"
        title="Cerrar Sesión"
        class="sidebar-logout-btn"
      >
        🚪
      </button>
    </div>

  </div>
</aside>

<script>
  import { getLocalSession, logoutUser } from '../../services/auth';

  // ── Mobile Drawer ──
  const toggleBtn  = document.getElementById('mobile-menu-toggle');
  const sidebar    = document.getElementById('app-sidebar');
  const overlay    = document.getElementById('sidebar-overlay');

  function openMenu()  {
    sidebar?.classList.add('sidebar--open');
    overlay?.classList.add('sidebar-overlay--visible');
  }

  function closeMenu() {
    sidebar?.classList.remove('sidebar--open');
    overlay?.classList.remove('sidebar-overlay--visible');
  }

  toggleBtn?.addEventListener('click', () => {
    sidebar?.classList.contains('sidebar--open') ? closeMenu() : openMenu();
  });

  overlay?.addEventListener('click', closeMenu);

  // ── Selector de tema ──
  const themeDots = document.querySelectorAll<HTMLButtonElement>('[data-theme-value]');
  const htmlEl    = document.documentElement;

  function applyTheme(theme: string) {
    htmlEl.setAttribute('data-theme', theme);
    localStorage.setItem('pos-theme', theme);

    // Actualizar dot activo
    themeDots.forEach(dot => {
      dot.classList.toggle('sidebar-theme-dot--active', dot.dataset.themeValue === theme);
    });
  }

  // Restaurar tema guardado
  const savedTheme = localStorage.getItem('pos-theme') || 'light';
  applyTheme(savedTheme);

  // Asignar click a cada dot
  themeDots.forEach(dot => {
    dot.addEventListener('click', () => {
      const theme = dot.dataset.themeValue;
      if (theme) applyTheme(theme);
    });
  });

  // ── Sesión de usuario ──
  const session       = getLocalSession();
  const nameEl        = document.getElementById('user-display-name');
  const roleEl        = document.getElementById('user-display-role');
  const avatarEl      = document.getElementById('user-avatar-initials');
  const logoutBtn     = document.getElementById('btn-logout');

  if (session?.user) {
    const nombre  = session.user.user_metadata?.nombre || session.user.email || 'Admin';
    const rol     = session.user.user_metadata?.rol || 'admin';
    const initials = nombre.charAt(0).toUpperCase();

    if (nameEl)   nameEl.textContent   = nombre;
    if (roleEl)   roleEl.textContent   = rol.charAt(0).toUpperCase() + rol.slice(1);
    if (avatarEl) avatarEl.textContent = initials;
  } else {
    if (window.location.pathname !== '/login') {
      window.location.href = '/login';
    }
  }

  logoutBtn?.addEventListener('click', async () => {
    await logoutUser();
    window.location.href = '/login';
  });
</script>
