---
export interface Props {
  title: string;
  value: string;
  subtitle: string;
  icon: string;
  color?: string;
}

const { title, value, subtitle, icon, color = 'var(--color-accent)' } = Astro.props;
---

<div class="stats-card">
  <div class="stats-card-header">
    <span class="stats-card-title">{title}</span>
    <div class="stats-card-icon">
      {icon}
    </div>
  </div>
  <div class="stats-card-value">{value}</div>
  <div class="stats-card-subtitle">{subtitle}</div>
</div>
