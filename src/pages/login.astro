---
import { pwaInfo } from 'virtual:pwa-info';
import { LoginForm } from '../components/auth/LoginForm';
import '../styles/global.css';
import '../styles/productos.css';

const supabaseUrl = import.meta.env.PUBLIC_SUPABASE_URL || 'https://obabigruajliljzympth.supabase.co';
const supabaseAnonKey = import.meta.env.PUBLIC_SUPABASE_ANON_KEY || '';
---

<html lang="es">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="icon" href="/favicon.svg" type="image/svg+xml">
    <title>Acceso — Terminal POS</title>
    { pwaInfo && <Fragment set:html={pwaInfo.webManifest.linkTag} /> }
  </head>
  <body style="background-color: var(--bg-primary); min-height: 100vh; display: flex; align-items: center; justify-content: center; padding: 1rem;">
    <main style="width: 100%;">
      <LoginForm client:load supabaseUrl={supabaseUrl} supabaseAnonKey={supabaseAnonKey} />
    </main>
    <script src="/src/pwa.ts"></script>
  </body>
</html>
