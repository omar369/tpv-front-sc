---
import Layout from '../layouts/Layout.astro';
import StatsCard from '../components/dashboard/StatsCard.astro';
import QuickActions from '../components/dashboard/QuickActions.astro';
import '../styles/dashboard.css';
---

<Layout title="Dashboard — Terminal POS">
  <div class="dashboard-container">
    <div class="dashboard-header">
      <h1 class="page-title">Dashboard Principal</h1>
      <p class="page-subtitle">Bienvenido a la Terminal Punto de Venta PWA</p>
    </div>

    <!-- Grid de Métricas del Dashboard -->
    <div class="dashboard-stats-grid">
      <StatsCard
        title="Ventas de Hoy"
        value="$0.00"
        subtitle="0 transacciones registradas"
        icon="💳"
      />
      <StatsCard
        title="Productos en Catálogo"
        value="--"
        subtitle="Conectado con Supabase DB"
        icon="📦"
      />
      <StatsCard
        title="Estado de API"
        value="Activa"
        subtitle="FastAPI backend responde OK"
        icon="⚡"
      />
    </div>

    <!-- Acciones Rápidas -->
    <QuickActions />
  </div>
</Layout>
